<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Razor Pages sample</title>
    <link rel="stylesheet" href="~/_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.bundle.scp.css" />
</head>
<body>
    <main role="main" style="max-width: 1200px; margin: 0 auto; padding: 24px;">
        @RenderBody()
    </main>
    <script src="~/_framework/blazor.server.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
